{
  "id": "interview_01_conference",
  "title": "面试 01 · 行业会议",
  "brief": "你要用一份会议邀请函和一份『整理过』的流水，说服签证官你只是去开三天会。",
  "round_limit": 8,
  "suspicion_limit": 100,
  "starting_suspicion": 5,
  "starting_materials": [
