    "invitation",
    "bank_statement",
    "employment",
    "hotel_booking"
  ],
  "required_categories": [
    "identity",
    "funds",
    "purpose"
  ],
  "category_weights": {
    "identity": 0.25,
    "funds": 0.35,
    "purpose": 0.4
  },
  "min_credibility_for_coverage": 50,
  "probe_formula": "pressure = 30 + suspicion * 0.6；robustness < pressure 即被击穿",
